# Application settings
APP_NAME="AI English Tutor Backend"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
SECRET_KEY="aaabd7b795d723a98f3c8ae5baddf0aecd6eb239c4795c8eb7b321d8a9bca2bb0d"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/ai_tutor_db"
DATABASE_URL_SYNC="postgresql://postgres:postgres@db:5432/ai_tutor_db"

# Redis Configuration
REDIS_URL="redis://redis:6379/0"

# ==============================================================================
# 100% FREE SETUP (NO PAID API KEYS REQUIRED)
# ==============================================================================

# LLM Provider Configuration
# Option A: "mock" - Zero API key, local intelligent tutor generator (Free)
# Option B: "openai" - Connect to free local Ollama (LLM_BASE_URL="http://host.docker.internal:11434/v1")
LLM_PROVIDER="mock"
LLM_BASE_URL=""
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""

# TTS Provider Configuration
# "gtts" - Google Text-To-Speech library (100% Free, High-Quality Neural MP3 Audio, No API key needed)
TTS_PROVIDER="gtts"
TTS_MODEL="standard"
TTS_BASE_URL=""
TTS_API_KEY=""
DEFAULT_VOICE="female_01"
DEFAULT_TTS_SPEED=0.95

# Language & Grammar Engine (100% Free Local Engines)
LANGUAGE_DETECTION_PROVIDER="fast"
GRAMMAR_PROVIDER="rule_llm"
